+bool videoInput::getFormats(int deviceID, int& formats)
+{
+    formats = 0;
+    if (deviceID < 0 || deviceID >= VI_MAX_CAMERAS || !isDeviceSetup(deviceID))
+        return false;
+
+    videoDevice* VD = VDList[deviceID];
+    if (!VD->streamConf)
+        return false;
+
+    for (int i = 0; i < VI_MAX_FORMATS; ++i)
+    {
+        formatWidths[deviceID][i] = 0;
+        formatHeights[deviceID][i] = 0;
+        formatFps[deviceID][i] = 0;
+        formatFrameIntervals[deviceID][i] = 0;
+        formatSubtypes[deviceID][i] = GUID_NULL;
+        formatSubtypeNames[deviceID][i].clear();
+    }
+
+    int iCount = 0, iSize = 0;
+    HRESULT hr = VD->streamConf->GetNumberOfCapabilities(&iCount, &iSize);
+    if (FAILED(hr) || iSize != sizeof(VIDEO_STREAM_CONFIG_CAPS))
+        return false;
+
+    IAMVideoControl* pAMVidControl = NULL;
+    IPin* pCameraCapturePin = NULL;
+    if (VD->pVideoInputFilter)
+        VD->pVideoInputFilter->QueryInterface(IID_IAMVideoControl, (void**)&pAMVidControl);
+    if (VD->pCaptureGraph)
+        VD->pCaptureGraph->FindPin(VD->pVideoInputFilter, PINDIR_OUTPUT, 0, 0, TRUE, 0, &pCameraCapturePin);
+
+    for (int iFormat = 0; iFormat < iCount && formats < VI_MAX_FORMATS; ++iFormat)
+    {
+        VIDEO_STREAM_CONFIG_CAPS scc;
+        AM_MEDIA_TYPE* pmt = NULL;
+        hr = VD->streamConf->GetStreamCaps(iFormat, &pmt, (BYTE*)&scc);
+        if (FAILED(hr) || !pmt)
+        {
+            if (pmt)
+                MyDeleteMediaType(pmt);
+            continue;
+        }
+
+        int width = scc.InputSize.cx;
+        int height = scc.InputSize.cy;
+        LONGLONG frameInterval = 0;
+        if (pmt->pbFormat)
+        {
+            VIDEOINFOHEADER* pVih = reinterpret_cast<VIDEOINFOHEADER*>(pmt->pbFormat);
+            width = HEADER(pVih)->biWidth;
+            height = HEADER(pVih)->biHeight;
+            frameInterval = pVih->AvgTimePerFrame;
+        }
+        if (height < 0)
+            height = -height;
+
+        char guidStr[8];
+        getMediaSubtypeAsString(pmt->subtype, guidStr);
+
+        bool addedFrameRate = false;
+        if (pAMVidControl && pCameraCapturePin && width > 0 && height > 0)
+        {
+            SIZE frameSize;
+            frameSize.cx = width;
+            frameSize.cy = height;
+            long listSize = 0;
+            LONGLONG* frameRates = NULL;
+            hr = pAMVidControl->GetFrameRateList(pCameraCapturePin, iFormat, frameSize, &listSize, &frameRates);
+            if (SUCCEEDED(hr) && frameRates)
+            {
+                for (long i = 0; i < listSize && formats < VI_MAX_FORMATS; ++i)
+                {
+                    if (frameRates[i] <= 0)
+                        continue;
+                    formatWidths[deviceID][formats] = width;
+                    formatHeights[deviceID][formats] = height;
+                    formatFps[deviceID][formats] = cvRound(10000000.0 / (double)frameRates[i]);
+                    formatFrameIntervals[deviceID][formats] = frameRates[i];
+                    formatSubtypes[deviceID][formats] = pmt->subtype;
+                    formatSubtypeNames[deviceID][formats] = guidStr;
+                    ++formats;
+                    addedFrameRate = true;
+                }
+                CoTaskMemFree(frameRates);
+            }
+        }
+
+        if (!addedFrameRate && formats < VI_MAX_FORMATS)
+        {
+            formatWidths[deviceID][formats] = width;
+            formatHeights[deviceID][formats] = height;
+            formatFps[deviceID][formats] = frameInterval > 0 ? cvRound(10000000.0 / (double)frameInterval) : 0;
+            formatFrameIntervals[deviceID][formats] = frameInterval;
+            formatSubtypes[deviceID][formats] = pmt->subtype;
+            formatSubtypeNames[deviceID][formats] = guidStr;
+            ++formats;
+        }
+
+        MyDeleteMediaType(pmt);
+    }
+
+    if (pCameraCapturePin)
+        pCameraCapturePin->Release();
+    if (pAMVidControl)
+        pAMVidControl->Release();
+
+    return true;
+}
