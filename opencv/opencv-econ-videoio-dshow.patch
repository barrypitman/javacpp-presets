+bool videoInput::getFormatType(int deviceID, int format, String& formatType, int& width, int& height, int& fps)
+{
+    if (deviceID < 0 || deviceID >= VI_MAX_CAMERAS || format < 0 || format >= VI_MAX_FORMATS)
+        return false;
+
+    if (formatWidths[deviceID][format] <= 0)
+    {
+        int count = 0;
+        if (!getFormats(deviceID, count) || format >= count)
+            return false;
+    }
+
+    formatType = formatSubtypeNames[deviceID][format];
+    width = formatWidths[deviceID][format];
+    height = formatHeights[deviceID][format];
+    fps = formatFps[deviceID][format];
+    return !formatType.empty() && width > 0 && height > 0;
+}
+
+bool videoInput::setFormatType(int deviceID, int format)
+{
+    if (deviceID < 0 || deviceID >= VI_MAX_CAMERAS || format < 0 || format >= VI_MAX_FORMATS)
+        return false;
+
+    String formatType;
+    int width = 0, height = 0, fps = 0;
+    if (!getFormatType(deviceID, format, formatType, width, height, fps))
+        return false;
+
+    bool convertRGB = isDeviceSetup(deviceID) ? getConvertRGB(deviceID) : true;
+    int fourcc = getFourccFromMediaSubtype(formatSubtypes[deviceID][format]);
+    stopDevice(deviceID);
+    setIdealFramerate(deviceID, fps);
+    bool success = setupDeviceFourcc(deviceID, width, height, fourcc);
+    if (success)
+        setConvertRGB(deviceID, convertRGB);
+    return success;
+}
