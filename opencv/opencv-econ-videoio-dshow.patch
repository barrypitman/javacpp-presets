+bool videoInput::getVideoSettingFilterEx(int deviceID, long Property, int& min, int& max, int& steppingDelta,
+                                         int& supportedMode, int& currentValue, int& currentMode, int& defaultValue)
+{
+    if (!isDeviceSetup(deviceID))
