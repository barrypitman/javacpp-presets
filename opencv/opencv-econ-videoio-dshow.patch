+bool VideoCapture_DShow::getVideoProperty(int propIdx, int& min, int& max, int& steppingDelta, int& supportedMode,
+                                          int& currentValue, int& currentMode, int& defaultValue)
+{
+    if (m_index < 0)
+        return false;
+
+    switch (propIdx)
+    {
+    case CAP_PROP_BRIGHTNESS:
+    case CAP_PROP_CONTRAST:
+    case CAP_PROP_HUE:
+    case CAP_PROP_SATURATION:
+    case CAP_PROP_SHARPNESS:
+    case CAP_PROP_GAMMA:
+    case CAP_PROP_MONOCHROME:
+    case cv::VideoCaptureProperties::CAP_PROP_WB_TEMPERATURE:
+    case cv::VideoCaptureProperties::CAP_PROP_AUTO_WB:
+    case CAP_PROP_BACKLIGHT:
+    case CAP_PROP_GAIN:
+        return g_VI.getVideoSettingFilterEx(m_index, g_VI.getVideoPropertyFromCV(propIdx), min, max,
+                                            steppingDelta, supportedMode, currentValue, currentMode, defaultValue);
+
+    case CAP_PROP_PAN:
+    case CAP_PROP_TILT:
+    case CAP_PROP_ROLL:
+    case CAP_PROP_ZOOM:
+    case CAP_PROP_EXPOSURE:
+    case CAP_PROP_AUTO_EXPOSURE:
+    case CAP_PROP_IRIS:
+    case CAP_PROP_FOCUS:
+    case CAP_PROP_AUTOFOCUS:
+        return g_VI.getVideoSettingCameraEx(
+                m_index,
+                propIdx == CAP_PROP_AUTO_EXPOSURE ? CameraControl_Exposure :
+                propIdx == CAP_PROP_AUTOFOCUS ? CameraControl_Focus : g_VI.getCameraPropertyFromCV(propIdx),
+                min, max, steppingDelta, supportedMode, currentValue, currentMode, defaultValue);
+    default:
+        break;
+    }
+    return false;
+}
+
+bool VideoCapture_DShow::setVideoProperty(int propIdx, int value, int mode)
+{
+    if (m_index < 0)
+        return false;
+
+    switch (propIdx)
+    {
+    case CAP_PROP_BRIGHTNESS:
+    case CAP_PROP_CONTRAST:
+    case CAP_PROP_HUE:
+    case CAP_PROP_SATURATION:
+    case CAP_PROP_SHARPNESS:
+    case CAP_PROP_GAMMA:
+    case CAP_PROP_MONOCHROME:
+    case cv::VideoCaptureProperties::CAP_PROP_WB_TEMPERATURE:
+    case cv::VideoCaptureProperties::CAP_PROP_AUTO_WB:
+    case CAP_PROP_BACKLIGHT:
+    case CAP_PROP_GAIN:
+        return g_VI.setVideoSettingFilter(m_index, g_VI.getVideoPropertyFromCV(propIdx), value, mode);
+
+    case CAP_PROP_PAN:
+    case CAP_PROP_TILT:
+    case CAP_PROP_ROLL:
+    case CAP_PROP_ZOOM:
+    case CAP_PROP_EXPOSURE:
+    case CAP_PROP_AUTO_EXPOSURE:
+    case CAP_PROP_IRIS:
+    case CAP_PROP_FOCUS:
+    case CAP_PROP_AUTOFOCUS:
+        return g_VI.setVideoSettingCamera(
+                m_index,
+                propIdx == CAP_PROP_AUTO_EXPOSURE ? CameraControl_Exposure :
+                propIdx == CAP_PROP_AUTOFOCUS ? CameraControl_Focus : g_VI.getCameraPropertyFromCV(propIdx),
+                value, mode);
+    default:
+        break;
+    }
+    return false;
+}
