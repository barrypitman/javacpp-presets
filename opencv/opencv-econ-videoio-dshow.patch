+static char asciiToLower(char c)
+{
+    return (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+}
+
+static const char* findAsciiNoCase(const char* value, const char* needle)
+{
+    if (!value || !needle || !needle[0])
+        return NULL;
+
+    for (const char* current = value; *current; ++current)
+    {
+        const char* lhs = current;
+        const char* rhs = needle;
+        while (*lhs && *rhs && asciiToLower(*lhs) == asciiToLower(*rhs))
+        {
+            ++lhs;
+            ++rhs;
+        }
+        if (!*rhs)
+            return current;
+    }
+    return NULL;
+}
+
+static void copyBstrToAscii(BSTR value, char* out, size_t outSize)
+{
+    if (!out || outSize == 0)
+        return;
+
+    out[0] = 0;
+    if (!value)
+        return;
+
+    size_t i = 0;
+    for (; value[i] != 0 && i + 1 < outSize; ++i)
+        out[i] = (char)value[i];
+    out[i] = 0;
+}
+
+static void copyUsbIdFromDevicePath(const char* devicePath, const char* marker, char* out, size_t outSize)
+{
+    if (!out || outSize == 0)
+        return;
+
+    out[0] = 0;
+    const char* found = findAsciiNoCase(devicePath, marker);
+    if (!found)
+        return;
+
+    found += strlen(marker);
+    size_t i = 0;
+    for (; found[i] && i < 4 && i + 1 < outSize; ++i)
+        out[i] = found[i];
+    out[i] = 0;
+}
+
