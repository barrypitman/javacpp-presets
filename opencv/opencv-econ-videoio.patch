+static inline int autoControlForProperty(int property_id)
+{
+    switch (property_id) {
+    case cv::CAP_PROP_WHITE_BALANCE_BLUE_U:
+    case cv::CAP_PROP_WB_TEMPERATURE:
+        return capPropertyToV4L2(cv::CAP_PROP_AUTO_WB);
+    case cv::CAP_PROP_FOCUS:
+        return capPropertyToV4L2(cv::CAP_PROP_AUTOFOCUS);
+    case cv::CAP_PROP_EXPOSURE:
+        return capPropertyToV4L2(cv::CAP_PROP_AUTO_EXPOSURE);
+    default:
+        return -1;
+    }
+}
+
+static inline bool autoControlValueMeansAuto(int property_id, int value)
+{
+    if (property_id == cv::CAP_PROP_EXPOSURE)
+        return value == V4L2_EXPOSURE_AUTO;
+    return value != 0;
+}
