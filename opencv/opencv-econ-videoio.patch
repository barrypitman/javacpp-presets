+bool CvCaptureCAM_V4L::getVideoProperty(int property_id, int& min, int& max, int& steppingDelta,
+                                        int& supportedMode, int& currentValue, int& currentMode,
+                                        int& defaultValue)
+{
+    min = max = steppingDelta = supportedMode = currentValue = currentMode = defaultValue = 0;
+
+    int manualId = capPropertyToV4L2(property_id);
+    if (manualId == -1)
+        return false;
+
+    v4l2_queryctrl manualQuery = v4l2_queryctrl();
+    manualQuery.id = static_cast<__u32>(manualId);
+    bool manualSupported = tryIoctl(VIDIOC_QUERYCTRL, &manualQuery, false);
+
+    v4l2_control manualControl = v4l2_control();
+    manualControl.id = static_cast<__u32>(manualId);
+    manualSupported = manualSupported && tryIoctl(VIDIOC_G_CTRL, &manualControl, false);
+
+    int autoId = autoControlForProperty(property_id);
+    v4l2_control autoControl = v4l2_control();
+    bool autoSupported = false;
+    if (autoId != -1)
+    {
+        v4l2_queryctrl autoQuery = v4l2_queryctrl();
+        autoQuery.id = static_cast<__u32>(autoId);
+        autoControl.id = static_cast<__u32>(autoId);
+        autoSupported = tryIoctl(VIDIOC_QUERYCTRL, &autoQuery, false) &&
+                        tryIoctl(VIDIOC_G_CTRL, &autoControl, false);
+    }
+
+    if (!manualSupported && !autoSupported)
+        return false;
+
+    if (manualSupported)
+    {
+        min = manualQuery.minimum;
+        max = manualQuery.maximum;
+        steppingDelta = manualQuery.step;
+        defaultValue = manualQuery.default_value;
+        currentValue = manualControl.value;
+    }
+
+    supportedMode = autoSupported && manualSupported ? 3 : (autoSupported ? 1 : 2);
+    if (autoSupported)
+        currentMode = autoControlValueMeansAuto(property_id, autoControl.value) ? 1 : 2;
+    else
+        currentMode = 2;
+
+    return true;
+}
