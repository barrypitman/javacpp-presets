+struct V4LDeviceInfo
+{
+    String deviceName;
+    String vid;
+    String pid;
+    String devicePath;
+};
+
+static bool queryV4LDeviceNode(const String& devicePath, V4LDeviceInfo& info)
+{
+    if (devicePath.empty())
+        return false;
+
+    int fd = ::open(devicePath.c_str(), O_RDWR | O_NONBLOCK, 0);
+    if (fd < 0)
+        return false;
+
+    v4l2_capability cap = v4l2_capability();
+    bool valid = false;
+    if (ioctl(fd, VIDIOC_QUERYCAP, &cap) >= 0)
+    {
+        __u32 caps = cap.device_caps ? cap.device_caps : cap.capabilities;
+        valid = (caps & (V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_VIDEO_CAPTURE_MPLANE)) != 0 &&
+                (caps & V4L2_CAP_META_CAPTURE) == 0;
+    }
+    ::close(fd);
+
+    if (!valid)
+        return false;
+
+    info.devicePath = devicePath;
+    info.deviceName = (const char*)cap.card;
+    return true;
+}
+
+static std::vector<V4LDeviceInfo> getV4LDevices()
+{
+    std::vector<V4LDeviceInfo> devices;
+
+#ifdef HAVE_LIBUDEV
+    struct udev* udev_ctx = udev_new();
+    if (udev_ctx)
+    {
+        struct udev_enumerate* enumerate = udev_enumerate_new(udev_ctx);
+        if (enumerate)
+        {
+            udev_enumerate_add_match_subsystem(enumerate, "video4linux");
+            udev_enumerate_scan_devices(enumerate);
+
+            struct udev_list_entry* entries = udev_enumerate_get_list_entry(enumerate);
+            struct udev_list_entry* entry = NULL;
+            udev_list_entry_foreach(entry, entries)
+            {
+                const char* path = udev_list_entry_get_name(entry);
+                struct udev_device* dev = udev_device_new_from_syspath(udev_ctx, path);
+                if (!dev)
+                    continue;
+
+                const char* devnode = udev_device_get_devnode(dev);
+                V4LDeviceInfo info;
+                if (devnode && queryV4LDeviceNode(devnode, info))
+                {
+                    struct udev_device* parent = udev_device_get_parent_with_subsystem_devtype(dev, "usb", "usb_device");
+                    if (parent)
+                    {
+                        const char* vid = udev_device_get_sysattr_value(parent, "idVendor");
+                        const char* pid = udev_device_get_sysattr_value(parent, "idProduct");
+                        if (vid)
+                            info.vid = vid;
+                        if (pid)
+                            info.pid = pid;
+                    }
+                    devices.push_back(info);
+                }
+                udev_device_unref(dev);
+            }
+            udev_enumerate_unref(enumerate);
+        }
+        udev_unref(udev_ctx);
+    }
+#endif
+
+    if (devices.empty())
+    {
+        for (int i = 0; i < MAX_CAMERAS; ++i)
+        {
+            V4LDeviceInfo info;
+            if (queryV4LDeviceNode(cv::format("/dev/video%d", i), info))
+            {
+                devices.push_back(info);
+            }
+        }
+    }
+
+    std::sort(devices.begin(), devices.end(), [](const V4LDeviceInfo& lhs, const V4LDeviceInfo& rhs) {
+        return lhs.devicePath < rhs.devicePath;
+    });
+    return devices;
+}
+
+bool get_V4L_devices(int& devices)
+{
+    devices = static_cast<int>(getV4LDevices().size());
+    return true;
+}
+
+bool get_V4L_device_info(int index, String& deviceName, String& vid, String& pid, String& devicePath)
+{
+    deviceName.clear();
+    vid.clear();
+    pid.clear();
+    devicePath.clear();
+
+    std::vector<V4LDeviceInfo> devices = getV4LDevices();
+    if (index < 0 || index >= static_cast<int>(devices.size()))
+        return false;
+
+    const V4LDeviceInfo& info = devices[index];
+    deviceName = info.deviceName;
+    vid = info.vid;
+    pid = info.pid;
+    devicePath = info.devicePath;
+    return true;
+}
