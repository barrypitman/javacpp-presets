+struct V4LFormatInfo
+{
+    __u32 fourcc;
+    String formatType;
+    int width;
+    int height;
+    int fps;
+};
+
+static String fourccToString(__u32 fourcc)
+{
+    char value[5];
+    value[0] = static_cast<char>(fourcc & 0xff);
+    value[1] = static_cast<char>((fourcc >> 8) & 0xff);
+    value[2] = static_cast<char>((fourcc >> 16) & 0xff);
+    value[3] = static_cast<char>((fourcc >> 24) & 0xff);
+    value[4] = '\0';
+    return String(value);
+}
+
+static std::vector<V4LFormatInfo> enumerateV4LFormats(int deviceHandle, v4l2_buf_type type)
+{
+    std::vector<V4LFormatInfo> formats;
+    if (deviceHandle < 0)
+        return formats;
+
+    v4l2_fmtdesc fmt = v4l2_fmtdesc();
+    fmt.type = type;
+    while (ioctl(deviceHandle, VIDIOC_ENUM_FMT, &fmt) == 0)
+    {
+        v4l2_frmsizeenum frmsize = v4l2_frmsizeenum();
+        frmsize.pixel_format = fmt.pixelformat;
+        while (ioctl(deviceHandle, VIDIOC_ENUM_FRAMESIZES, &frmsize) == 0)
+        {
+            if (frmsize.type == V4L2_FRMSIZE_TYPE_DISCRETE)
+            {
+                v4l2_frmivalenum frmival = v4l2_frmivalenum();
+                frmival.pixel_format = frmsize.pixel_format;
+                frmival.width = frmsize.discrete.width;
+                frmival.height = frmsize.discrete.height;
+                bool foundInterval = false;
+                while (ioctl(deviceHandle, VIDIOC_ENUM_FRAMEINTERVALS, &frmival) == 0)
+                {
+                    if (frmival.type == V4L2_FRMIVAL_TYPE_DISCRETE && frmival.discrete.numerator != 0)
+                    {
+                        formats.push_back(V4LFormatInfo{
+                            fmt.pixelformat,
+                            fourccToString(fmt.pixelformat),
+                            static_cast<int>(frmsize.discrete.width),
+                            static_cast<int>(frmsize.discrete.height),
+                            static_cast<int>(frmival.discrete.denominator / frmival.discrete.numerator)
+                        });
+                        foundInterval = true;
+                    }
+                    ++frmival.index;
+                }
+                if (!foundInterval)
+                {
+                    formats.push_back(V4LFormatInfo{
+                        fmt.pixelformat,
+                        fourccToString(fmt.pixelformat),
+                        static_cast<int>(frmsize.discrete.width),
+                        static_cast<int>(frmsize.discrete.height),
+                        0
+                    });
+                }
+            }
+            ++frmsize.index;
+        }
+        ++fmt.index;
+    }
+    return formats;
+}
+
+bool CvCaptureCAM_V4L::getFormats(int& formats)
+{
+    formats = static_cast<int>(enumerateV4LFormats(deviceHandle, type).size());
+    return isOpened();
+}
+
+bool CvCaptureCAM_V4L::getFormatType(int format, String& formatType, int& outWidth, int& outHeight, int& outFps)
+{
+    formatType.clear();
+    outWidth = 0;
+    outHeight = 0;
+    outFps = 0;
+
+    std::vector<V4LFormatInfo> formats = enumerateV4LFormats(deviceHandle, type);
+    if (format <= 0 || format > static_cast<int>(formats.size()))
+        return false;
+
+    const V4LFormatInfo& info = formats[format - 1];
+    formatType = info.formatType;
+    outWidth = info.width;
+    outHeight = info.height;
+    outFps = info.fps;
+    return true;
+}
+
+bool CvCaptureCAM_V4L::setFormatType(int format)
+{
+    std::vector<V4LFormatInfo> formats = enumerateV4LFormats(deviceHandle, type);
+    if (format <= 0 || format > static_cast<int>(formats.size()))
+        return false;
+
+    const V4LFormatInfo& info = formats[format - 1];
+    return setProperty(CAP_PROP_FOURCC, static_cast<double>(info.fourcc)) &&
+           setProperty(CAP_PROP_FRAME_WIDTH, info.width) &&
+           setProperty(CAP_PROP_FRAME_HEIGHT, info.height) &&
+           (info.fps <= 0 || setProperty(CAP_PROP_FPS, info.fps));
+}
